# GPU image for nnU-Net training and inference (Tier 1/2 machines).
FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    nnUNet_raw=/app/data/nnUNet_raw nnUNet_preprocessed=/app/data/nnUNet_preprocessed \
    nnUNet_results=/app/data/nnUNet_results nnUNet_extTrainer=/app/src/btqc/train/trainers
WORKDIR /app
COPY pyproject.toml README.md LICENSE ./
COPY src ./src
RUN pip install --no-cache-dir -e ".[train,dev]"
COPY configs ./configs
COPY scripts ./scripts
COPY tests ./tests
# Mount the labeled data and outputs: -v /data/fets:/app/data
CMD ["python", "scripts/tasks.py", "--list"]
